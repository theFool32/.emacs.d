;;; desktop-startup-tests.el --- Desktop startup checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'seq)

;; These isolated tests stub native and filesystem functions, so do not
;; compile trampolines while those stubs are installed.
(setq native-comp-enable-subr-trampolines nil)

(defvar +my/desktop-ready nil)
(defvar +my/start-time (current-time))
(defvar doom-modeline-mode nil)
(defvar +self/use-rime nil)
(defvar rime--lib-loaded nil)
(defvar rime-user-data-dir nil)

(with-temp-buffer
  (insert-file-contents
   (expand-file-name "../init.el" (file-name-directory load-file-name)))
  (goto-char (point-min))
  (condition-case nil
      (while t
        (let ((form (read (current-buffer))))
          (when (and (eq (car-safe form) 'defun)
                     (string-prefix-p "+my/desktop-" (symbol-name (cadr form))))
            (eval form t))))
    (end-of-file nil)))

(ert-deftest desktop-initial-buffer-waits-for-packages-and-a-graphical-frame ()
  (let ((agenda-calls 0)
        (+my/desktop-ready nil))
    (cl-letf (((symbol-function '+my/open-org-agenda)
               (lambda () (cl-incf agenda-calls)))
              ((symbol-function 'display-graphic-p) (lambda (&optional _) t)))
      (+my/desktop-initial-buffer)
      (should (zerop agenda-calls))
      (setq +my/desktop-ready t)
      (should (bufferp (+my/desktop-initial-buffer)))
      (should (= agenda-calls 1)))
    (cl-letf (((symbol-function '+my/open-org-agenda)
               (lambda () (ert-fail "Agenda opened on the daemon terminal")))
              ((symbol-function 'display-graphic-p) (lambda (&optional _) nil)))
      (should (bufferp (+my/desktop-initial-buffer))))))

(ert-deftest desktop-startup-does-not-open-an-agenda-in-the-daemon ()
  (let ((+my/desktop-ready nil))
    (cl-letf (((symbol-function 'daemonp) (lambda () "test"))
              ((symbol-function '+my/open-org-agenda)
               (lambda () (ert-fail "Agenda opened before a client"))))
      (+my/desktop-startup-finished)
      (should +my/desktop-ready))))

(ert-deftest desktop-daemon-preloads-rime-before-accepting-clients ()
  (let ((+my/desktop-ready nil)
        (+self/use-rime t)
        (rime--lib-loaded nil)
        (rime-user-data-dir "/private/tmp/test-rime/")
        (original-input-method current-input-method)
        events)
    (cl-letf (((symbol-function 'daemonp) (lambda () t))
              ((symbol-function 'require)
               (lambda (feature &rest _)
                 (should (eq feature 'rime))
                 (push 'package events)
                 t))
              ((symbol-function 'file-directory-p) (lambda (_) t))
              ((symbol-function 'rime--load-dynamic-module)
               (lambda ()
                 (should-not +my/desktop-ready)
                 (setq rime--lib-loaded t)
                 (push 'engine events)))
              ((symbol-function 'activate-input-method)
               (lambda (&rest _) (ert-fail "Preloading changed the input method"))))
      (+my/desktop-startup-finished)
      (should +my/desktop-ready)
      (should rime--lib-loaded)
      (should (equal (nreverse events) '(package engine)))
      (should (equal current-input-method original-input-method)))))

(ert-deftest desktop-rime-preload-respects-daemon-mode-and-the-user-option ()
  (dolist (settings '((nil t) (t nil)))
    (let ((+self/use-rime (cadr settings)))
      (cl-letf (((symbol-function 'daemonp) (lambda () (car settings)))
                ((symbol-function 'require)
                 (lambda (&rest _) (ert-fail "Rime was eagerly loaded"))))
        (+my/desktop-preload-rime)))))

(ert-deftest desktop-rime-preload-keeps-an-already-running-engine ()
  (let ((+self/use-rime t)
        (rime--lib-loaded t))
    (cl-letf (((symbol-function 'daemonp) (lambda () t))
              ((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'rime--load-dynamic-module)
               (lambda () (ert-fail "The existing Rime engine was restarted"))))
      (+my/desktop-preload-rime))))

(ert-deftest desktop-rime-preload-failure-does-not-block-client-startup ()
  (let ((+my/desktop-ready nil)
        (+self/use-rime t)
        (rime--lib-loaded nil)
        (rime-user-data-dir "/private/tmp/test-rime/")
        messages)
    (cl-letf (((symbol-function 'daemonp) (lambda () t))
              ((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'file-directory-p) (lambda (_) t))
              ((symbol-function 'rime--load-dynamic-module) (lambda () (error "Missing native module")))
              ((symbol-function 'message)
               (lambda (format-string &rest args)
                 (push (apply #'format format-string args) messages))))
      (+my/desktop-startup-finished)
      (should +my/desktop-ready)
      (should-not rime--lib-loaded)
      (should (seq-some (lambda (text) (string-match-p "Rime preload failed: Missing native module" text))
                        messages)))))

(ert-deftest desktop-rime-preload-does-not-prompt-for-a-first-deployment ()
  (let ((+self/use-rime t)
        (rime--lib-loaded nil)
        (rime-user-data-dir "/private/tmp/test-rime/"))
    (cl-letf (((symbol-function 'daemonp) (lambda () t))
              ((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'file-directory-p) (lambda (_) nil))
              ((symbol-function 'rime--load-dynamic-module)
               (lambda () (ert-fail "Rime would prompt without a GUI")))
              ((symbol-function 'message) #'ignore))
      (+my/desktop-preload-rime)
      (should-not rime--lib-loaded))))

(ert-deftest desktop-initial-buffer-returns-the-displayed-agenda-not-the-server-buffer ()
  (let ((agenda (generate-new-buffer "*test startup agenda*"))
        (+my/desktop-ready t))
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (setq default-directory "/private/tmp/")
            (let ((source (current-buffer)))
              (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _) t))
                        ((symbol-function '+my/open-org-agenda)
                         ;; Org restores its caller's buffer after showing its UI.
                         (lambda () (save-current-buffer (switch-to-buffer agenda)))))
                (should (eq (+my/desktop-initial-buffer) agenda))
                (should (eq (window-buffer (selected-window)) agenda))
                (should (eq (current-buffer) source))
                (should (equal default-directory "/private/tmp/"))
                (should (equal (buffer-local-value 'default-directory agenda)
                               (file-name-as-directory (expand-file-name "~"))))))))
      (kill-buffer agenda))))

(ert-deftest desktop-frame-p-excludes-terminal-popup-and-minibuffer-frames ()
  (cl-letf (((symbol-function 'frame-live-p) (lambda (_) t))
            ((symbol-function 'display-graphic-p) (lambda (f) (not (eq f 'terminal))))
            ((symbol-function 'frame-parameter)
             (lambda (f key)
               (cond ((and (eq f 'popup) (eq key 'parent-frame)) 'parent)
                     ((and (eq f 'minibuffer) (eq key 'minibuffer)) 'only)))))
    (should (+my/desktop-frame-p 'regular))
    (dolist (frame '(terminal popup minibuffer))
      (should-not (+my/desktop-frame-p frame)))))

(ert-deftest desktop-initial-buffer-shows-a-real-org-agenda ()
  (require 'org-agenda)
  (let* ((file (make-temp-file "desktop-agenda-" nil ".org" "* TODO Desktop startup test\n"))
         (org-agenda-files (list file))
         (org-agenda-custom-commands '(("p" "Desktop test" ((alltodo "")))))
         (org-agenda-window-setup 'current-window)
         (org-agenda-buffer-name (generate-new-buffer-name "*test desktop agenda*"))
         (+my/desktop-ready t))
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (setq default-directory "/private/tmp/")
            (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _) t))
                      ((symbol-function '+my/open-org-agenda)
                       (lambda ()
                         ;; Org itself renders on the real batch terminal.
                         (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _) nil)))
                           (org-agenda nil "p")))))
              (let ((buffer (+my/desktop-initial-buffer)))
                (should (eq (window-buffer (selected-window)) buffer))
                (with-current-buffer buffer
                  (should (derived-mode-p 'org-agenda-mode))
                  (should (string-match-p "Desktop startup test" (buffer-string)))
                  (should (equal default-directory (file-name-as-directory (expand-file-name "~")))))))))
      (when-let* ((buffer (get-buffer org-agenda-buffer-name)))
        (kill-buffer buffer))
      (when-let* ((buffer (get-file-buffer file)))
        (kill-buffer buffer))
      (delete-file file))))

(ert-deftest desktop-focus-reuses-a-frame-without-changing-the-current-buffer ()
  (let ((original (current-buffer)) visible focused activated)
    (cl-letf (((symbol-function 'frame-list) (lambda () '(popup existing terminal)))
              ((symbol-function '+my/desktop-frame-p) (lambda (f) (eq f 'existing)))
              ((symbol-function 'make-frame-visible) (lambda (f) (setq visible f)))
              ((symbol-function 'select-frame) (lambda (&rest _) 'existing))
              ((symbol-function 'select-frame-set-input-focus) (lambda (f) (setq focused f)))
              ((symbol-function 'window-system) (lambda (&optional _) 'ns))
              ((symbol-function 'ns-hide-emacs) (lambda (action) (setq activated action)))
              ((symbol-function '+my/open-org-agenda)
               (lambda () (ert-fail "Focusing a frame replaced the current work"))))
      (should (+my/desktop-focus-frame))
      (should (eq visible 'existing))
      (should (eq focused 'existing))
      (should (eq activated 'activate))
      (should (eq original (current-buffer)))))
  (cl-letf (((symbol-function 'frame-list) (lambda () nil)))
    (should-not (+my/desktop-focus-frame))))

(ert-deftest desktop-cocoa-activation-does-not-hide-the-app-after-raising-it ()
  (let ((hidden t) events)
    (cl-letf (((symbol-function '+my/desktop-frame-p) (lambda (_) t))
              ((symbol-function 'window-system) (lambda (&optional _) 'ns))
              ((symbol-function 'make-frame-visible) (lambda (_) (push 'visible events)))
              ((symbol-function 'select-frame) (lambda (&rest _) (push 'selected events)))
              ((symbol-function 'ns-hide-emacs)
               ;; Match the Cocoa build: only `activate' activates; other
               ;; non-nil values (including `activate-front') hide the app.
               (lambda (action)
                 (setq hidden (and action (not (eq action 'activate))))
                 (push (if hidden 'hidden 'activated) events)))
              ((symbol-function 'select-frame-set-input-focus)
               (lambda (_) (push 'raised-and-focused events))))
      (should (+my/desktop-activate-frame 'client))
      (should-not hidden)
      (should (equal (nreverse events)
                     '(visible selected activated raised-and-focused))))))

(ert-deftest desktop-client-ready-activates-its-own-frame ()
  (let (activated)
    (cl-letf (((symbol-function '+my/desktop-activate-frame)
               (lambda (frame) (setq activated frame)))
              ((symbol-function 'frame-list)
               (lambda () (ert-fail "Activation selected some other frame"))))
      (+my/desktop-client-frame-ready)
      (should (eq activated (selected-frame))))))

(ert-deftest desktop-fonts-are-ready-before-the-graphical-modeline-loads ()
  (let ((+my/desktop-ready t)
        (doom-modeline-mode nil)
        events)
    (cl-letf (((symbol-function '+my/desktop-frame-p) (lambda (_) t))
              ((symbol-function 'set-face-attribute)
               (lambda (face _ &rest attributes)
                 (if (eq face 'diff-hl-change)
                     (progn
                       (should (eq (plist-get attributes :foreground) 'unspecified))
                       (push 'diff-face-set events))
                   (push 'latin-font events))))
              ((symbol-function 'facep) (lambda (face) (eq face 'diff-hl-change)))
              ((symbol-function 'face-background) (lambda (&rest _) nil))
              ((symbol-function 'set-fontset-font)
               (lambda (name &rest _)
                 (should (eq name t))
                 (push 'cjk-font events)))
              ((symbol-function 'set-frame-parameter) #'ignore)
              ((symbol-function 'doom-modeline-mode)
               (lambda (value)
                 (should (= value 1))
                 (should (= (cl-count 'cjk-font events) 5))
                 (setq doom-modeline-mode t)
                 (push 'modeline-enabled events)))
              ((symbol-function 'doom-modeline--reset-font-height-cache)
               (lambda () (push 'font-cache-reset events)))
              ((symbol-function 'doom-modeline-refresh-bars)
               (lambda () (push 'bars-refreshed events)))
              ((symbol-function 'doom-modeline-invalidate-huds) #'ignore)
              ((symbol-function 'force-mode-line-update) #'ignore))
      (+my/desktop-setup-frame (selected-frame))
      (should (memq 'modeline-enabled events))
      (should (memq 'diff-face-set events))
      (should (memq 'font-cache-reset events))
      (should (memq 'bars-refreshed events)))))

(ert-deftest desktop-keeps-popup-fonts-and-does-not-load-modeline-headlessly ()
  (let ((+my/desktop-ready t))
    (cl-letf (((symbol-function '+my/desktop-frame-p) (lambda (_) nil))
              ((symbol-function 'set-face-attribute)
               (lambda (&rest _) (ert-fail "Popup font was replaced")))
              ((symbol-function 'doom-modeline-mode)
               (lambda (&rest _) (ert-fail "Modeline loaded without a graphical frame"))))
      (+my/desktop-setup-frame (selected-frame)))))

(ert-deftest desktop-refreshing-a-frame-keeps-the-modeline-enabled ()
  (let ((doom-modeline-mode t)
        (mode-line-format '("existing")))
    (cl-letf (((symbol-function 'doom-modeline-mode)
               (lambda (&rest _) (ert-fail "Existing modeline was toggled")))
              ((symbol-function 'doom-modeline--reset-font-height-cache) #'ignore)
              ((symbol-function 'doom-modeline-refresh-bars) #'ignore)
              ((symbol-function 'doom-modeline-invalidate-huds) #'ignore)
              ((symbol-function 'force-mode-line-update) #'ignore))
      (+my/desktop-setup-modeline)
      (+my/desktop-setup-modeline)
      (should doom-modeline-mode))))
